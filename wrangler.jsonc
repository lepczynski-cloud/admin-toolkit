{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "admin-toolkit",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
